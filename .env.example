# Konfigurasi lingkungan lokal (salin ke .env dan isi nilainya)
# Jangan commit file .env yang berisi secret/sebenarnya ke repository.

# PocketBase server (sudah berjalan di http://127.0.0.1:8090)
POCKETBASE_URL=http://127.0.0.1:8090

# (Opsional) Supabase — ditinggalkan untuk kompatibilitas dokumentasi lama
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
